# HTTP + WebSocket port
PORT=8787
HOST=127.0.0.1
# Browser origins allowed to use the API/WebSocket (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated, in priority order. Supported: openai, ollama
# Leave empty to run fully offline on heuristics + native dictionary.
LLM_PROVIDERS=openai,ollama

# Cloud provider (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local lightweight model via Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b

# A provider whose rolling latency exceeds this budget is skipped in favour of the next one.
LLM_LATENCY_BUDGET_MS=2500
# Budget for whole-paragraph AI rewrites (longer output).
LLM_REWRITE_BUDGET_MS=8000

# Optional path to the compiled native helper (see native/macos/DictionaryHelper).
MACOS_DICTIONARY_HELPER=
